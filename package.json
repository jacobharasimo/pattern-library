{
  "name": "pattern-library",
  "version": "6.6.1",
  "description": "Shared components among all Getro applications",
  "author": "Getro",
  "license": "MIT",
  "repository": "getro/rombo",
  "main": "dist/index.js",
  "sideEffects": false,
  "module": "dist/index.modern.js",
  "source": "src/index.js",
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "build": "microbundle-crl --no-compress --format modern,cjs --jsxFragment React.Fragment --sourcemap=false",
    "build:storybook": "build-storybook -c .storybook",
    "deploy": "gh-pages -d example/build",
    "lint": "npm run lint:js",
    "lint:js": "eslint 'src/**/*.js'",
    "lint:fix:js": "npm run lint:js -- --fix",
    "npm:publish": "rm -fr ./dist && npm publish",
    "npm:publish:beta": "rm -fr ./dist && npm publish --tag beta",
    "predeploy": "cd example && yarn install && yarn run build",
    "prepare": "run-s build",
    "start": "microbundle-crl watch --no-compress --format modern,cjs --jsxFragment React.Fragment",
    "storybook": "npm run storybook:open",
    "storybook:open": "start-storybook -p 9009 -s public -c .storybook",
    "test": "SKIP_PREFLIGHT_CHECK=true react-scripts test --env=jsdom --coverage",
    "test:ci": "SKIP_PREFLIGHT_CHECK=true CI=true react-scripts test --env=jsdom --coverage --maxWorkers 2",
    "test:build": "run-s build",
    "version:check": "node ./versionCheck",
    "version:publish": "node ./gitVersion",
    "yalc:publish": "rm -fr ./dist && npx yalc publish"
  },
  "dependencies": {
    "@draft-js-plugins/anchor": "^4.1.3",
    "@draft-js-plugins/buttons": "^4.1.1",
    "@draft-js-plugins/editor": "^4.1.1",
    "@draft-js-plugins/inline-toolbar": "^4.1.2",
    "@draft-js-plugins/static-toolbar": "^4.1.2",
    "@styled-system/should-forward-prop": "^5.1.5",
    "caniuse-lite": "^1.0.30001342",
    "draft-js": "^0.11.7",
    "draft-js-list-plugin": "^1.0.2",
    "draft-js-markdown-shortcuts-plugin": "^0.6.1",
    "focus-trap-react": "^8.4.2",
    "js-cookie": "^3.0.1",
    "markdown-draft-js": "^2.1.1",
    "marked": "^0.7.0",
    "normalize.css": "^8.0.1",
    "react-dropzone": "^11.2.4",
    "react-grid-system": "^7.1.1",
    "react-table": "^7.7.0",
    "react-virtuoso": "^2.8.6"
  },
  "peerDependencies": {
    "@rebass/forms": "^4.0.6",
    "@rebass/preset": "^4.0.5",
    "debounce": "^1.2.0",
    "formik": "^2.2.9",
    "react": ">16",
    "react-dom": ">16",
    "react-feather": "^2.0.8",
    "react-popper-tooltip": "^4.3.1",
    "react-select": "^3.1.0",
    "rebass": "^4.0.7",
    "semantic-ui-react": "^2.0.3",
    "styled-components": "^5.1.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.10.4",
    "@babel/core": "^7.10.4",
    "@babel/plugin-proposal-private-property-in-object": "^7.14.0",
    "@babel/preset-env": "^7.10.4",
    "@babel/preset-react": "^7.10.4",
    "@rebass/forms": "^4.0.6",
    "@rebass/preset": "^4.0.5",
    "@storybook/addon-a11y": "^6.5.9",
    "@storybook/addon-docs": "^6.5.9",
    "@storybook/addon-essentials": "^6.5.9",
    "@storybook/addon-knobs": "^6.4.0",
    "@storybook/addon-links": "^6.5.9",
    "@storybook/addon-notes": "^5.3.21",
    "@storybook/addon-viewport": "^6.5.9",
    "@storybook/addons": "^6.5.9",
    "@storybook/preset-scss": "^1.0.3",
    "@storybook/react": "^6.5.9",
    "@testing-library/jest-dom": "^5.11.9",
    "@testing-library/react": "^11.2.3",
    "@testing-library/react-hooks": "^3.4.1",
    "@testing-library/user-event": "^12.1.0",
    "autoprefixer": "^9.8.5",
    "babel-eslint": "^10.0.3",
    "chalk": "^4.1.0",
    "cross-env": "^7.0.2",
    "debounce": "^1.2.0",
    "eslint": "^6.8.0",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-config-prettier": "^7.0.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-prettier": "^3.3.0",
